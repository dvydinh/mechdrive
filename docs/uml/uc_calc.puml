@startuml
left to right direction
skinparam packageStyle rectangle

actor "Mechanical Engineer" as eng
actor "Supabase System" as db << System >>

package "Calculation Engine" {
  together {
    usecase "Design Motor" as UC1
    usecase "Design Chain Drive" as UC2
    usecase "Design Gear Drive" as UC3
    usecase "Lookup Standard Data" as UC5
  }
  
  usecase "Calculate Power & Speed" as UC1_1
  usecase "Select Standard Motor" as UC1_2
  usecase "Calculate Sprocket Teeth" as UC2_1
  usecase "Check Chain Stress" as UC2_2
  usecase "Design Helical Gear" as UC3_2
  usecase "Check Gear Stress (sigma_H, sigma_F)" as UC3_3
}

eng --> UC1
UC1 ..> UC1_1 : <<include>>
UC1 ..> UC1_2 : <<include>>

eng --> UC2
UC2 ..> UC2_1 : <<include>>
UC2 ..> UC2_2 : <<include>>

eng --> UC3
UC3 ..> UC3_2 : <<include>>
UC3 ..> UC3_3 : <<include>>

eng --> UC5

UC1_2 <-- db
UC2 <-- db
UC3 <-- db
UC5 <-- db

@enduml
