@startuml
left to right direction
skinparam packageStyle rectangle

actor "Mechanical Engineer" as eng

package "AI Optimizer" {
  together {
    usecase "Optimize via Q-Learning" as UC1
  }
  
  usecase "Discretize Input State" as UC1_1
  usecase "Lookup Q-Table (local JSON)" as UC1_2
  usecase "Recommend Material & Gear Type" as UC1_3
  usecase "Predict z1, psi_ba, u_d" as UC1_4
}

eng --> UC1
UC1 ..> UC1_1 : <<include>>
UC1 ..> UC1_2 : <<include>>
UC1 ..> UC1_3 : <<include>>
UC1 ..> UC1_4 : <<include>>

@enduml
